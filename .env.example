# Your WhatsApp number in international format, digits only (no +, no spaces).
# Example for a Sri Lankan mobile 077 123 4567  ->  94771234567
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public URL of the site (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://cmdcashews.lk

# Postgres connection string. On Vercel: Storage -> Create Database -> Neon.
# Vercel fills this in automatically when you connect the database to the project.
DATABASE_URL=

# Password for the /admin page (orders + prices). Pick something long.
ADMIN_PASSWORD=
